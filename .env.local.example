# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-Role-Key: serverseitiger Voll-Zugriff, umgeht RLS. NIEMALS mit
# NEXT_PUBLIC-Prefix versehen — darf nie ins Client-Bundle. Wird von getClient()
# bevorzugt; damit ist RLS-Härtung (supabase/harden_rls.sql) möglich.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Brevo (ehemals Sendinblue)
BREVO_API_KEY=xkeysib-...

# Calendly — Buchungslink für Mail 4 ({{CALENDLY_BUTTON}}).
# Fallback ist die Konstante in lib/pitch-constants.ts (CALENDLY_URL).
# Setzen wenn die produktive URL von der Konstante abweichen soll.
CALENDLY_URL=https://calendly.com/niklas-primesocial/15min

# Docupilot
DOCUPILOT_API_KEY=your-docupilot-api-key
DOCUPILOT_TEMPLATE_ID=your-template-id

# ── Stellensignal-Modul (Apify) ──────────────────────────────────
# Apify-Token (wird auch vom Instagram-/Recherche-Scraper genutzt).
APIFY_API_TOKEN=apify_api_...

# MASTER-Schalter für den täglichen Crawl. Default AUS.
STELLENSIGNALE_ENABLED=false

# Pro Plattform EINZELN scharf schalten (default aus). Zusätzlich muss die
# jeweilige Actor-ID gesetzt sein — sonst kein Call, keine Kosten.
STELLENSIGNALE_KLEINANZEIGEN=false
STELLENSIGNALE_ARBEITSAGENTUR=false
STELLENSIGNALE_INDEED=false

# Firmensuche über Google Maps (findet Betriebe auch OHNE Stellenanzeige und
# liefert die Website → Voraussetzung für die Impressum-Mail-Findung).
# Nutzt denselben Actor wie das Recherche-Modul (APIFY_GMAPS_ACTOR).
STELLENSIGNALE_MAPS=false
STELLENSIGNALE_MAPS_MAX_QUERIES=3

# Apify-Actor-IDs je Plattform. LEER = Plattform wird übersprungen.
APIFY_KLEINANZEIGEN_ACTOR=
APIFY_ARBEITSAGENTUR_ACTOR=
APIFY_INDEED_ACTOR=

# Kosten-Deckel (bewusst niedrige Defaults — zum Hochtasten):
STELLENSIGNALE_MAX_ITEMS=25        # max. Anzeigen je Plattform-Query
STELLENSIGNALE_ACTOR_TIMEOUT=90    # Sek — Apify beendet den Run danach hart
STELLENSIGNALE_MAX_QUERIES=20      # max. Ort×Gewerk-Kombis je Cron-Lauf
STELLENSIGNALE_MANUAL_MAX_QUERIES=3 # noch engerer Deckel für den Test-Button
STELLENSIGNALE_EMAIL_LIMIT=25      # max. Impressum-Checks je Lauf (gratis)

# Teurer Email-Fallback — nur wenn Impressum/Pattern nichts findet.
STELLENSIGNALE_HUNTER=false
ANTHROPIC_API_KEY=sk-ant-...
BREVO_API_KEY=xkeysib-...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...